{
  "opencollection": "1.0.0",
  "info": {
    "name": "OneCLI Agent Setup Partner Secrets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Partner Secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List partner secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.onecli.sh/v1/partner/secrets"
          },
          "docs": "Returns the partner-level secrets inherited by every organization you manage. Secret values are never returned."
        },
        {
          "info": {
            "name": "Create a partner secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.onecli.sh/v1/partner/secrets",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a partner-level secret inherited by every organization you manage. Partner secrets are the lowest-priority tier — project and organization secrets override them when host patterns overlap.\n"
        },
        {
          "info": {
            "name": "Update a partner secret",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.onecli.sh/v1/partner/secrets/:secretId",
            "params": [
              {
                "name": "secretId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates one or more fields on a partner secret. At least one field must be provided."
        },
        {
          "info": {
            "name": "Delete a partner secret",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.onecli.sh/v1/partner/secrets/:secretId",
            "params": [
              {
                "name": "secretId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a partner secret"
        }
      ]
    }
  ],
  "bundled": true
}