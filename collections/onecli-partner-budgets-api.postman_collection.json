        {
          "id": "aebd02f5-3ee3-4b53-a1f4-210103f6b713",
          "name": "Set or update a spend budget",
          "request": {
            "name": "Set or update a spend budget",
            "description": {
              "content": "Caps how much an organization can spend on one of your LLM keys. When the organization's spend reaches the limit, the gateway stops using that key for the organization until the budget is raised or reset. Creates the budget, or replaces the existing one.\n\nOnly partner owners and admins can set budgets, and budgets are supported on metered LLM keys (Anthropic today).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "partner",
                "orgs",
                ":orgId",
                "secrets",
                ":secretId",
                "budget"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "orgId",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "secretId",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limitCents\": \"<integer>\",\n  \"period\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
