          "id": "09b9a81b-8473-40c0-8230-47d27d59eac6",
          "name": "Submit an approval decision",
          "request": {
            "name": "Submit an approval decision",
            "description": {
              "content": "Approve or deny a pending manual-approval request. Approving forwards the held request to its upstream service; denying blocks it. Scope the call to the request's project with a project API key or an `X-Project-Id` header.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "approvals",
                ":id",
                "decision"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The approval ID from `GET /approvals/pending`."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
