      "name": "Approvals",
      "description": {
        "content": "Long-poll for pending manual-approval requests and submit approve/deny decisions.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "83a02b0d-950e-47af-a678-5442cdcf260a",
          "name": "List pending approvals",
          "request": {
            "name": "List pending approvals",
            "description": {
              "content": "Long-polls for manual-approval requests awaiting a decision in the current project. Returns immediately when any are pending, otherwise holds the connection open (up to `timeoutSeconds`) until one arrives or the poll times out.\n\nAuthenticate with a project API key, or an organization key plus an `X-Project-Id` header. Submit each decision to `POST /approvals/{id}/decision`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "approvals",
                "pending"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "exclude",
                  "value": "<string>",
                  "description": "Comma-separated approval IDs to skip (already being handled) so the poll can hold open for genuinely new requests."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
