        {
          "id": "f1504600-ab96-4aef-898b-0fec17e69eb3",
          "name": "Create a policy rule",
          "request": {
            "name": "Create a policy rule",
            "description": {
              "content": "Creates a new policy rule. Rules control how agents interact with external services:\n\n- **block** — reject matching requests outright.\n- **rate_limit** — allow up to N requests per time window. Requires `rateLimit` and `rateLimitWindow`.\n- **manual_approval** — hold matching requests for human approval before forwarding.\n- **allow** — explicitly allow matching requests (used to carve exceptions in deny mode or shadow a broader rule).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rules"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
