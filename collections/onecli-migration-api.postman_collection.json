          "id": "c876a36b-cba7-45ee-b385-a5feb2eee898",
          "name": "Export data to OneCLI Cloud",
          "request": {
            "name": "Export data to OneCLI Cloud",
            "description": {
              "content": "Exports the current self-hosted instance's data (secrets, agents, agent-secret assignments, rules) directly to OneCLI Cloud over HTTPS. Secrets are decrypted server-side and transmitted to Cloud; plaintext never reaches the caller.\n\nOnly available on self-hosted instances — Cloud returns 404.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "migrate",
                "export"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
